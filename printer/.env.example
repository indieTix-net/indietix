# Copy to .env and fill in your own values. Never commit .env.

# LAN IP of the Brother QL-820NWB. Set a DHCP reservation for it on your
# router so this doesn't drift over time.
PRINTER_HOST=192.168.1.50

# Port this agent listens on. Every computer's browser on the LAN will
# call http://<this-machine's-LAN-IP>:PORT -- not localhost, unless
# that specific browser is running on the same machine as the agent.
PORT=9191

# Media descriptor id for the label stock loaded in the printer.
# 259 = "62mm continuous (DK-22205)", the standard plain continuous
# roll. Both continuous and die-cut (precut, fixed-size) stock are
# supported -- for die-cut, the ticket is scaled to fit the label and
# centered instead of the feed length floating. Only change this if
# you've loaded different stock; see node_modules/@thermal-label/
# brother-ql-node and run `discovery.listMedia()` for the full catalog
# of ids -- e.g. 271 = "29x90mm die-cut (DK-11201)", Brother's standard
# address label.
MEDIA_ID=259

# Printable width in dots for the loaded media -- must match MEDIA_ID's
# `printableDots` from discovery.listMedia() (696 for DK-22205, 306 for
# DK-11201). The two are kept as separate env vars rather than derived
# automatically so a typo in one is caught by the printed preview
# looking wrong, not silently masked.
PRINT_WIDTH_DOTS=696
